# Dealroom API key: create one at https://app.dealroom.co (Settings > API). A key is a client id + secret pair.
DEALROOM_CLIENT_ID=
DEALROOM_CLIENT_SECRET=

# Optional. Defaults shown. Keys issued for the open beta host need
# DEALROOM_API_BASE_URL=https://api.beta.dealroom.app
DEALROOM_API_BASE_URL=
DEALROOM_AUDIENCE=
DEALROOM_TOKEN_URL=
DEALROOM_API_VERSION=
DEALROOM_REQUESTS_PER_SECOND=
DEALROOM_TIMEOUT_MS=

# Optional. Where the local SQLite cache lives (default ./sheeply.sqlite).
SHEEPLY_DB=
